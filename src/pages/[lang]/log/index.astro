---
import Base from '../../../layouts/Base.astro';
import { LOCALES, keyOf, url, type Lang } from '../../../lib/i18n';
import { listEntries } from '../../../lib/content';
import { ui } from '../../../lib/ui';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const t = ui[lang];
const base = import.meta.env.BASE_URL;
const items = await listEntries('log', lang);
---
<Base lang={lang} title={t.log}>
  <h1>{t.log}</h1>
  {items.length === 0 ? <p class="muted">{t.noLog}</p> : (
    <ul class="list">
      {items.map((e) => (
        <li>
          <a href={url(base, `/${lang}/log/${keyOf(e.id)}/`)}><strong>{e.data.title}</strong></a>
          <div class="muted">{e.data.date.toISOString().slice(0, 10)} {e.data.tags.map((x) => `#${x}`).join(' ')}</div>
        </li>
      ))}
    </ul>
  )}
</Base>
